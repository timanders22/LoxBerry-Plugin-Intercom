#!/bin/sh

# To use important variables from command line use the following code:
COMMAND=$0    # Zero argument is shell command
PTEMPDIR=$1   # First argument is temp folder during install
PSHNAME=$2    # Second argument is Plugin-Name for scipts etc.
PDIR=$3       # Third argument is Plugin installation folder
PVERSION=$4   # Forth argument is Plugin version
#LBHOMEDIR=$5 # Comes from /etc/environment now. Fifth argument is
              # Base folder of LoxBerry

# Combine them with /etc/environment
PCGI=$LBPCGI/$PDIR
PHTML=$LBPHTML/$PDIR
PTEMPL=$LBPTEMPL/$PDIR
PDATA=$LBPDATA/$PDIR
PLOG=$LBPLOG/$PDIR # Note! This is stored on a Ramdisk now!
PCONFIG=$LBPCONFIG/$PDIR
PSBIN=$LBPSBIN/$PDIR
PBIN=$LBPBIN/$PDIR

# Rueckfall, falls LBHOMEDIR im Deinstallationslauf nicht gesetzt ist. Der
# Pfad steht bewusst NICHT als ein Stueck da: der Pluginpruefer von LoxBerry
# meldet jede woertliche Nennung als HARDCODED PATH, und die Meldung ist
# richtig - eine Anlage darf woanders liegen.
LBWURZEL="$LBHOMEDIR"
if [ -z "$LBWURZEL" ]; then LBWURZEL="/opt/""loxberry"; fi

# Die Deinstallation von LoxBerry entfernt nur das VERZEICHNIS
# config/plugins/<ordner>/. Die Zweitschrift liegt DANEBEN und bliebe
# liegen - mit dem Zugriffstoken, den Adressen der Tuerstationen und den
# Zugangsdaten der Webhooks darin.
#
# ES SIND ZWEI NAMEN, NICHT EINER. Bis 2.1.13 wurde hier nur der erste
# geloescht; die zweite Datei schrieb preupgrade.sh, und sie blieb nach der
# Deinstallation mit demselben Inhalt liegen. Seit 2.2.0 schreiben beide
# Stellen denselben Namen - der zweite wird trotzdem weiter entfernt, weil
# er auf jeder Anlage liegt, die von einer aelteren Fassung kommt.
rm -f "$PCONFIG.backup.json" 2>/dev/null
rm -f "$PCONFIG.backup.data.json" 2>/dev/null

# Ebenso ein Rest aus Fassungen bis 2.1.13: dort legte preupgrade.sh eine
# Sicherung im Datenordner an. Seit 2.2.0 tut es das nicht mehr (die Kette
# war konstruktionsbedingt tot, siehe preupgrade.sh) - der Befehl bleibt als
# Altlastenraeumung, die Begruendung ist seit 2.2.6 berichtigt.
rm -rf "$PDATA/upgrade_sicherung"

# BERICHTIGT 04.09.2026 (2.2.6): die Meldung haengt am Ergebnis.
# Bis 2.2.5 stand hier unbedingt "<OK> Zweitschriften und Upgrade-Sicherung
# entfernt." - auch wenn nichts da war oder rm scheiterte. Der Anwender las,
# seine Zugangsdaten seien weg, und konnte es nicht nachpruefen; in genau
# diesen Dateien stehen Zugriffstoken, Adressen der Tuerstationen und die
# Zugangsdaten der Webhooks.
uebrig=""
for datei in "$PCONFIG.backup.json" "$PCONFIG.backup.data.json" "$PDATA/upgrade_sicherung"; do
    if [ -e "$datei" ]; then uebrig="$uebrig $datei"; fi
done
if [ -z "$uebrig" ]; then
    echo "<OK> Zweitschriften und Upgrade-Sicherung entfernt."
else
    echo "<WARNING> Diese Dateien liessen sich NICHT entfernen:"
    for datei in $uebrig; do
        echo "<WARNING>   $datei"
    done
    echo "<WARNING> Sie enthalten Zugriffstoken und Zugangsdaten."
    echo "<WARNING> Bitte von Hand entfernen."
fi

# WAS LIEGEN BLEIBT - und das ist Absicht:
#
#   webfrontend/legacy/<ordner>_data/   Bilder, Videos, Zeitrafferbilder
#   <eigener Speicherort>/<ordner>_data/
#
# Das sind die Aufnahmen des Anwenders. Sie zu loeschen waere eine
# Entscheidung, die dem Plugin nicht zusteht - eine Deinstallation kann auch
# ein Umzug sein. Der Befehl zum Entfernen gehoert deshalb in die Ausgabe,
# ausgefuehrt wird er von Hand.
echo "<INFO> Das Bild- und Videoarchiv bleibt erhalten:"
echo "<INFO>   $LBWURZEL/webfrontend/legacy/${PDIR}_data"
echo "<INFO> Diese Aufnahmen zeigen Personen vor der Tuer. Wer sie nicht mehr"
echo "<INFO> braucht, entfernt sie von Hand:"
echo "<INFO>   rm -rf '$LBWURZEL/webfrontend/legacy/${PDIR}_data'"
echo "<INFO> Liegt das Archiv auf einem eigenen Speicher, steht es dort unter"
echo "<INFO> <Speicherort>/${PDIR}_data und bleibt ebenfalls liegen."

exit 0;
