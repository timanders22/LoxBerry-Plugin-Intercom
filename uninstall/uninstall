#!/bin/sh

# Intercom - Deinstallation
#   $1 temporaerer Ordner, $2 Plugin-NAME, $3 Plugin-Ordner, $4 Fassung, $5 LoxBerry-Wurzel

# ==== Praefixschutz (NEU 2.2.23, Entwurf 3.6, E16; Gedaechtnis "Uninstall-Praefix") ====
#
# Am Geraet gemessen 08.10.2026 (plugininstall.pl :1570/:1603): beim Deinstallieren ruft der Installer JEDES
# data/system/uninstall/<name>* - auch dieses Skript, wenn ein Plugin deinstalliert wird, dessen NAME mit
# "intercom" beginnt (das Original hiess intercom22lox; ein Paar ist moeglich). $2 ist dann DESSEN Name und $3 DESSEN
# Ordner. Dann gehoert der Lauf nicht uns: nichts tun - keine Bruecke anhalten, nichts ueberschreiben, nichts loeschen.
if [ -n "$2" ] && [ "$2" != "intercom" ]; then
    echo "<INFO> Deinstallation von '$2' - dieses Skript gehoert zu 'intercom' und tut nichts."
    exit 0
fi

# ---- Wurzelblock (I1, seit 2.2.23; in allen Hakenskripten und uninstall woertlich gleich) ----
# Ordner aus $3 mit Schranke ('' . .. und alles mit / oder ..); Wurzel aus $5, sonst LBHOMEDIR, sonst vom Ablageort
# aufwaerts gesucht (Regeln/06 "Ein Systempfad wird nicht fest verdrahtet"). Eine Wurzel gilt nur mit
# config/plugins, data/plugins UND config/system/general.json - ein Rest alter Prueflaeufe hat die dritte nie.
# ic_wurzel setzt PDIR und BASE; Rueckgabe 0 = erkannt, 1 = Ordnername unzulaessig, 2 = keine LoxBerry-Wurzel.
# Bis 2.2.22 prueften preupgrade/postupgrade nur -z/-d, postinstall gar nicht (ohne $5 entstanden Ordner unter /,
# Pruefbericht I1), und keines suchte die Wurzel.
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
ic_wurzel() {
    PDIR="${1:-intercom}"
    case "$PDIR" in
        ''|.|..|*/*|*..*) return 1 ;;
    esac
    BASE="${2:-$LBHOMEDIR}"
    [ -n "$BASE" ] && [ -d "$BASE" ] || BASE=$(lb_wurzel_suchen)
    if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ] \
       || [ ! -f "$BASE/config/system/general.json" ]; then
        return 2
    fi
    return 0
}
# ---- Ende Wurzelblock ----
# ==== Pfade aus den Argumenten, mit Wurzelpruefung (seit 2.2.13, Wurzelblock seit 2.2.23) ====
# Ohne erkennbare Wurzel wird nichts geloescht, sondern gewarnt (fail closed, Regeln/06).
ic_wurzel "$3" "$5"
IC_W=$?
if [ "$IC_W" = 1 ]; then
    echo "<WARNING> Unzulaessiger Ordnername '$3' - es wurde nichts entfernt."
    exit 0
fi
if [ "$IC_W" != 0 ]; then
    echo "<WARNING> Kein LoxBerry-Wurzelverzeichnis erkannt ('${5:-$LBHOMEDIR}') - Zweitschriften, Marke,"
    echo "<WARNING> Bild- und Videolinks und die Befehlsbruecke wurden NICHT angefasst. Von Hand entfernen unter"
    echo "<WARNING> config/plugins/: <ordner>.backup.json, <ordner>.backup.data.json;"
    echo "<WARNING> unter data/plugins/: <ordner>.upgrade_laeuft, <ordner>.bildlinks.json, <ordner>.bildlinks/,"
    echo "<WARNING> <ordner>.videolinks.json, <ordner>/befehle/."
    exit 0
fi
PCONFIG="$BASE/config/plugins/$PDIR"
PDATA="$BASE/data/plugins/$PDIR"
LBWURZEL="$BASE"

# ==== Befehlsbruecke anhalten (NEU 2.2.23, Entwurf 3.6; Muster Chromecast 4 Lox NG 1.3.24) ====
# stop beendet Dienst und mosquitto_sub (auch ein verwaistes); danach argumentweise nachzaehlen, die Optionsdateien
# mit dem Broker-Kennwort ueberschreiben und den Ordner befehle/ entfernen. Laufende Auftragsprozesse enden von selbst
# (hoechstens eine Aufnahme von 300 s). Im Broker bleibt nichts: Quittungen und status/befehle sind nie retained.
BBSH="$BASE/bin/plugins/$PDIR/befehlsbruecke.sh"
BBPHP="$BASE/bin/plugins/$PDIR/befehlsbruecke.php"
BBDIR="$PDATA/befehle"
if [ -f "$BBSH" ] && command -v bash >/dev/null 2>&1; then
    echo "<INFO> Befehlsbruecke: $(timeout 40 bash "$BBSH" stop 2>&1 9>&- | head -n 1)"
fi
BB_REST=0
for bb_d in /proc/[0-9]*; do
    grep -qaF "befehlsbruecke.php" "$bb_d/cmdline" 2>/dev/null || continue
    bb_a0=$(tr '\0' '\n' < "$bb_d/cmdline" 2>/dev/null | sed -n 1p)
    bb_a1=$(tr '\0' '\n' < "$bb_d/cmdline" 2>/dev/null | sed -n 2p)
    bb_n=$(tr '\0' '\n' < "$bb_d/cmdline" 2>/dev/null | grep -c '')
    case "${bb_a0##*/}" in php|php[0-9]*) ;; *) continue ;; esac
    if [ "$bb_n" = 2 ] && [ "$bb_a1" = "$BBPHP" ]; then
        kill -9 "${bb_d#/proc/}" 2>/dev/null && BB_REST=$((BB_REST + 1))
    fi
done
BB_ABOS=0
for bb_d in /proc/[0-9]*; do
    [ "$(cat "$bb_d/comm" 2>/dev/null)" = "mosquitto_sub" ] || continue
    if tr '\0' '\n' < "$bb_d/environ" 2>/dev/null | grep -qxF "XDG_CONFIG_HOME=$BBDIR/mosquitto"; then
        kill -9 "${bb_d#/proc/}" 2>/dev/null && BB_ABOS=$((BB_ABOS + 1))
    fi
done
[ "$BB_REST" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_REST Dienst(e) erst mit kill -9 beendet."
[ "$BB_ABOS" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_ABOS mosquitto_sub erst mit kill -9 beendet."
if [ -d "$BBDIR" ]; then
    for bb_f in "$BBDIR/mosquitto/mosquitto_sub" "$BBDIR/mosquitto/mosquitto_pub"; do
        if [ -f "$bb_f" ] && [ ! -L "$bb_f" ]; then
            bb_n=$(stat -c %s "$bb_f" 2>/dev/null || echo 64)
            [ "$bb_n" -gt 0 ] 2>/dev/null && dd if=/dev/zero of="$bb_f" bs=1 count="$bb_n" conv=notrunc >/dev/null 2>&1
        fi
    done
    case "$BBDIR" in
        */data/plugins/?*/befehle) rm -rf "${BBDIR:?}" ;;
    esac
fi
if [ -e "$BBDIR/mosquitto/mosquitto_sub" ] || [ -e "$BBDIR/mosquitto/mosquitto_pub" ]; then
    echo "<WARNING> Befehlsbruecke: Optionsdateien liegen noch unter $BBDIR/mosquitto - von Hand entfernen."
elif [ -f "$BBSH" ]; then
    echo "<OK> Befehlsbruecke angehalten, ihre Zugangsdaten entfernt."
fi

# ==== Behaltene MQTT-Themen abraeumen (seit 2.2.13, M2, Entscheidung 3) ====
#
# Nur bei eingeschaltetem MQTT und nur die eigenen: <praefix>/bilder und
# <praefix>/ai_count, die retained hinausgehen. Leeres retain ueber den
# UDP-Eingang des Gateways, dreimal (UDP verliert), mit timeout. Seit 2.2.23
# mit stream_socket_client statt socket_create (Eigener Fund 8): ohne die
# PHP-Erweiterung sockets ging hier bis 2.2.22 nichts hinaus. Wie in ic_mqtt_an()
# gilt ein fehlender Schluessel mqtt_enable seit 2.2.23 als an (Vorgabe).
CF="$PCONFIG/data.json"
if [ -f "$CF" ] && command -v php >/dev/null 2>&1; then
    MQ=$(timeout 15 php -r '
        $c = json_decode((string) @file_get_contents($argv[1]), true);
        if (!is_array($c)) { echo "unlesbar"; exit(0); }
        $an = isset($c["mqtt_enable"]) ? (string) $c["mqtt_enable"] : "1";
        if (!in_array($an, array("1", "on", "true"), true)) { echo "aus"; exit(0); }
        $p = (isset($c["mqtt_praefix"]) && is_string($c["mqtt_praefix"]) && trim($c["mqtt_praefix"]) !== "")
           ? trim($c["mqtt_praefix"]) : $argv[3];
        $p = trim(preg_replace("#/+#", "/", preg_replace("#[^A-Za-z0-9_/-]#", "_", $p)), "/");
        $g = json_decode((string) @file_get_contents($argv[2]), true);
        $port = 0;
        foreach (array(array("Mqtt", "Udpinport"), array("mqtt", "udpinport")) as $k) {
            if (isset($g[$k[0]]) && is_array($g[$k[0]]) && isset($g[$k[0]][$k[1]])) {
                $port = (int) $g[$k[0]][$k[1]];
                if ($port) { break; }
            }
        }
        if ($p === "" || $port < 1 || $port > 65535) {
            echo "kein UDP-Eingangsport des Gateways"; exit(0);
        }
        $t = array($p . "/bilder", $p . "/ai_count");
        $ok = 0; $n = 0;
        for ($i = 0; $i < 3; $i++) {
            foreach ($t as $x) {
                $n++;
                $m = "retain " . $x;
                $s = @stream_socket_client("udp://127.0.0.1:" . $port, $en, $es, 1);
                if (!is_resource($s)) { continue; }
                if (@fwrite($s, $m) === strlen($m)) { $ok++; }
                fclose($s);
            }
        }
        echo ($ok === $n ? "ok " : "teil " . $ok . " von " . $n . ": ") . implode(", ", $t);
    ' "$CF" "$BASE/config/system/general.json" "$PDIR" 2>/dev/null)
    case "$MQ" in
        aus) echo "<INFO> MQTT war ausgeschaltet - es gibt keine behaltenen Themen abzuraeumen." ;;
        "ok "*) echo "<OK> Behaltene MQTT-Themen abgeraeumt: ${MQ#"ok "} (je dreimal an das Gateway gesendet; ob der Broker sie geloescht hat, laesst sich ueber UDP nicht nachlesen)." ;;
        *) echo "<WARNING> Die behaltenen MQTT-Themen liessen sich nicht abraeumen: ${MQ:-keine Antwort}" ;;
    esac
fi

# ==== Zweitschriften, Marke, Bild- und Videolinks ====
#
# Die Deinstallation von LoxBerry entfernt nur die VERZEICHNISSE config/plugins/<ordner>/ und data/plugins/<ordner>/.
# Was DANEBEN liegt, bliebe liegen - mit Zugriffstoken, Adressen und Kennwoertern der Tuerstationen, Zugangsdaten der
# Webhooks und den Token von SignalBot und Sprachsteuerung.
#
# BERICHTIGT 2.2.23 (I9, Regeln/06 "Das Deinstallationsskript ist fail-closed, ueberschreibt vor dem Loeschen und
# zaehlt nach"): reguelaere Dateien werden vor dem rm mit Nullen ueberschrieben (Block wie Alexa NG 1.0.5 uninstall
# :126-135; kein Verweis, auf Flash kein sicheres Loeschen). Bis 2.2.22 nur rm -f.
IC_WEG=0
for datei in "$PCONFIG.backup.json" "$PCONFIG.backup.data.json" \
             "$PCONFIG.backup.json.neu" "$PCONFIG.backup.json.alt" "$PCONFIG.backup.data.json.alt" \
             "$PCONFIG.data.json.kaputt" "$PCONFIG.data.json.kaputt.alt" \
             "$BASE/data/plugins/$PDIR.upgrade_laeuft" "$PDATA.bildlinks.json" "$PDATA.bildlinks.json.alt" \
             "$PDATA.mqtt_altlast.json" "$PDATA.videolinks.json" "$PDATA.videolinks.json.alt" \
             "$PDATA.videolinks.json.sperre"; do
    [ -e "$datei" ] || [ -L "$datei" ] || continue
    if [ -f "$datei" ] && [ ! -L "$datei" ]; then
        IC_N=$(stat -c %s "$datei" 2>/dev/null || echo 0)
        [ "$IC_N" -gt 0 ] 2>/dev/null && dd if=/dev/zero of="$datei" bs=1 count="$IC_N" conv=notrunc >/dev/null 2>&1
    fi
    rm -f "$datei" 2>/dev/null
    [ -e "$datei" ] || IC_WEG=$((IC_WEG + 1))
done
# Die Bildkopien je Link (seit 2.2.13, C11): erst jede Datei ueberschreiben, dann den Ordner.
for ordner in "$PDATA.bildlinks" "$PDATA.bildlinks.alt"; do
    case "$ordner" in
        "$BASE"/data/plugins/"$PDIR".bildlinks|"$BASE"/data/plugins/"$PDIR".bildlinks.alt) ;;
        *) continue ;;
    esac
    [ -d "$ordner" ] && [ ! -L "$ordner" ] || continue
    for f in "$ordner"/* "$ordner"/.sperre; do
        if [ -f "$f" ] && [ ! -L "$f" ]; then
            IC_N=$(stat -c %s "$f" 2>/dev/null || echo 0)
            [ "$IC_N" -gt 0 ] 2>/dev/null && dd if=/dev/zero of="$f" bs=1 count="$IC_N" conv=notrunc >/dev/null 2>&1
        fi
    done
    rm -rf "${ordner:?}" 2>/dev/null
    [ -e "$ordner" ] || IC_WEG=$((IC_WEG + 1))
done

# Ebenso ein Rest aus Fassungen bis 2.1.13: dort legte preupgrade.sh eine
# Sicherung im Datenordner an.
rm -rf "$PDATA/upgrade_sicherung"

# Nachgezaehlt wird VOR der Schlusszeile, auf denselben Pfaden (I5).
uebrig=""
for datei in "$PCONFIG.backup.json" "$PCONFIG.backup.data.json" "$PDATA/upgrade_sicherung" \
             "$PCONFIG.backup.json.neu" "$PCONFIG.backup.json.alt" "$PCONFIG.backup.data.json.alt" \
             "$PCONFIG.data.json.kaputt" "$PCONFIG.data.json.kaputt.alt" \
             "$BASE/data/plugins/$PDIR.upgrade_laeuft" "$PDATA.bildlinks.json" "$PDATA.bildlinks.json.alt" \
             "$PDATA.bildlinks" "$PDATA.bildlinks.alt" "$PDATA.mqtt_altlast.json" \
             "$PDATA.videolinks.json" "$PDATA.videolinks.json.alt" "$BBDIR"; do
    if [ -e "$datei" ]; then uebrig="$uebrig $datei"; fi
done
if [ -z "$uebrig" ]; then
    echo "<OK> Zweitschriften, Upgrade-Marke, Bild- und Videolinks entfernt ($IC_WEG ueberschrieben und geloescht; nachgezaehlt: 0 Reste)."
else
    echo "<WARNING> Diese Dateien liessen sich NICHT entfernen:"
    for datei in $uebrig; do
        echo "<WARNING>   $datei"
    done
    echo "<WARNING> Sie enthalten Zugriffstoken und Zugangsdaten."
    echo "<WARNING> Bitte von Hand entfernen."
fi

# WAS LIEGEN BLEIBT - und das ist Absicht:
#
#   webfrontend/legacy/<ordner>_data/   Bilder, Videos, Zeitrafferbilder
#   <eigener Speicherort>/<ordner>_data/
#
# Das sind die Aufnahmen des Anwenders. Sie zu loeschen waere eine
# Entscheidung, die dem Plugin nicht zusteht - eine Deinstallation kann auch
# ein Umzug sein.
echo "<INFO> Das Bild- und Videoarchiv bleibt erhalten:"
echo "<INFO>   $LBWURZEL/webfrontend/legacy/${PDIR}_data"
echo "<INFO> Diese Aufnahmen zeigen Personen vor der Tuer. Wer sie nicht mehr"
echo "<INFO> braucht, entfernt sie von Hand:"
echo "<INFO>   rm -rf '$LBWURZEL/webfrontend/legacy/${PDIR}_data'"
echo "<INFO> Liegt das Archiv auf einem eigenen Speicher, steht es dort unter"
echo "<INFO> <Speicherort>/${PDIR}_data und bleibt ebenfalls liegen."

exit 0;
