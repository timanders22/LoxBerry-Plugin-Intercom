#!/bin/sh
# Intercom - taeglicher Auftrag (Archiv-Bereinigung)
#
# Siehe den Kopf von cron/cron.01min: cron/crontab erreicht eine bestehende
# Anlage nie, die Ordner unter cron/ werden bei jedem Upgrade kopiert.
#
# EINE VERHALTENSAENDERUNG, UND SIE GEHOERT GENANNT
#
# Bis 2.2.7 lief die Bereinigung um 3:35 - die crontab konnte eine Uhrzeit
# nennen. Der Ordnerweg kann das nicht: cron.daily wird vom System gestartet,
# auf dieser Anlage um 4:23 (gemessen am 07.09.2026 in
# /etc/cron.d/lbdefaults). Fuer eine taegliche Bereinigung ist das ohne
# Belang - sie loescht alte Dateien, nicht zeitkritische. Wer eine feste
# Uhrzeit BRAUCHT, muesste den Auftrag nach cron.01min legen und dort selbst
# auf die Stunde pruefen; das waere 1440 Laeufe am Tag fuer einen, der
# etwas tut.

# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

WEB="REPLACELBPHTMLDIR"

if [ ! -d "$WEB" ]; then
	logger -t intercom "Web-Ordner nicht gefunden: $WEB"
	exit 1
fi
if [ ! -f "$WEB/cleanup.php" ]; then
	logger -t intercom "cleanup.php fehlt in $WEB"
	exit 1
fi

cd "$WEB" && /usr/bin/php cleanup.php 2>&1 | logger -t intercom
exit 0
