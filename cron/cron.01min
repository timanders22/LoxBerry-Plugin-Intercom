#!/bin/sh
# Intercom - minuetlicher Auftrag (Zeitraffer und Intervallaufnahme)
#
# WARUM DIESE DATEI UND NICHT MEHR cron/crontab
#
# Der Installateur kopiert cron/crontab NUR, wenn system/cron/cron.d/<NAME>
# noch nicht existiert (plugininstall.pl:989), und entfernt sie
# ausschliesslich beim Deinstallieren (:1571, "only on uninstall"). Auf einer
# bestehenden Anlage erreichte eine Aenderung an dieser Datei also NIE an -
# die Zeilen, die dort seit Jahren stehen, sind die der ERSTEN Installation.
#
# Die Ordner unter cron/ werden dagegen bei JEDEM Upgrade neu kopiert
# (plugininstall.pl:987-998). 43 Linien dieses Bestands liefern so aus.
#
# Aufgerufen wird die Datei vom Systemauftrag in /etc/cron.d/lbdefaults:
#     * * * * * loxberry cd / && for f in .../cron.01min/*; do ($f cron=01min &); done
# Sie laeuft also als loxberry, bekommt "cron=01min" als Argument (das hier
# niemanden interessiert) und muss AUSFUEHRBAR sein.
#
# DIE AUSGABE GEHT NICHT NACH /dev/null.
#
# Bis 2.1.13 endeten die Cron-Zeilen auf ">/dev/null 2>&1". Beide Skripte
# geben ihr Ergebnis per echo aus - es ging also ausnahmslos ins Nichts, und
# weder Zeitraffer noch Bereinigung hinterliessen eine Spur. Ein Cron-Dienst,
# der schweigend nichts tut, ist schlimmer als keiner.

# Waechter der Befehlsbruecke (seit 2.2.23, Gruppe 7; Entwurf 3.6, E15) - als ERSTE Anweisung, vor der Pruefung
# des Web-Ordners und vor timelapse.php ("vor den Sperren"): startet die Bruecke nach Boot und Update
# spaetestens nach einer Minute, wenn "Befehle ueber MQTT annehmen" gesetzt ist, und haelt sie sonst an
# (befehlsbruecke.php --waechter: misst zustand.json, nie waehrend einer Aktualisierung, hoechstens alle 600 s
# ein Neustart). Kein Start in den Hakenskripten - Intercom hat keinen Dauerdienst. Ausgabe nach /dev/null: die
# Bruecke protokolliert selbst (log/plugins/<ordner>/befehle_start.log).
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

BBSH="REPLACELBPBINDIR/befehlsbruecke.sh"
[ -f "$BBSH" ] && /bin/bash "$BBSH" waechter >/dev/null 2>&1

WEB="REPLACELBPHTMLDIR"

if [ ! -d "$WEB" ]; then
	logger -t intercom "Web-Ordner nicht gefunden: $WEB"
	exit 1
fi
if [ ! -f "$WEB/timelapse.php" ]; then
	logger -t intercom "timelapse.php fehlt in $WEB"
	exit 1
fi

cd "$WEB" && /usr/bin/php timelapse.php 2>&1 | logger -t intercom
exit 0
